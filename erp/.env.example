# Supabase → Connect → Transaction pooler (port 6543). Leave empty for local development (built-in PGlite in ./.data)
DATABASE_URL=

# Supabase → Connect → Session pooler (port 5432) — used only to run migrations on deploy
DATABASE_URL_DIRECT=

# Long random string used to sign login sessions:  openssl rand -hex 32
ERP_SECRET=

# Code asked on the first-run /setup screen (production only)
ERP_SETUP_CODE=
